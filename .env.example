# ---------- Public (exposed to the browser — never put secrets here) ----------
# Canonical domain, no trailing slash. Used for canonical URLs, Open Graph, sitemap.
VITE_SITE_URL=https://www.example.com
# WhatsApp business number, international format, digits only (e.g. 919800000000).
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_INSTAGRAM_URL=
# Optional: post enquiries somewhere other than the bundled /api/enquiry function.
VITE_ENQUIRY_ENDPOINT=

# ---------- Server only (set in Vercel → Project → Settings → Environment Variables) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: lock the API to your domain.
ALLOWED_ORIGIN=
# Optional email alert for each enquiry (https://resend.com)
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=
ENQUIRY_FROM_EMAIL=
